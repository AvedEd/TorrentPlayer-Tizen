<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://torrentplayer.local" version="0.1.0">
    <!-- Название приложения -->
    <name>TorrentPlayer</name>
    <description>TorrentPlayer - video player for Samsung Smart TV</description>

    <!-- Точка входа в корень проекта -->
    <content src="index.html" />

    <!-- Иконка приложения -->
    <icon src="assets/icon.png" />

    <!-- Настройки приложения Tizen -->
    <tizen:application id="TrntPlyr.TorrentPlayer" package="TrntPlyr" required_version="4.0" />

    <!-- Разрешение 1: Доступ к Интернету для связи с TorServe -->
    <tizen:privilege name="http://tizen.org/privilege/internet" />

    <!-- Разрешение 2: Перехват кнопок физического пульта Smart TV -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice" />

    <!-- Разрешение 3: Критически важно для работы нативного плеера AVPlay -->
    <tizen:privilege name="http://tizen.org" />

    <!-- Разрешение 4: Полноэкранный вывод видеопотока поверх интерфейса -->
    <tizen:privilege name="http://tizen.org" />

    <!-- Сетевые доступы к любым внешним IP-адресам TorServe -->
    <access origin="*" subdomains="true" />

    <!-- Блокировка указки (мыши) пульта для работы кнопок Вверх/Вниз -->
    <tizen:setting pointing-device-support="disable" />
</widget>
