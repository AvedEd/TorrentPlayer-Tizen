```xml
<?xml version="1.0" encoding="UTF-8"?>

<widget
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:tizen="http://tizen.org/ns/widgets"
    id="http://torrentplayer.local"
    version="0.1.0">

    <!-- Название приложения -->
    <name>TorrentPlayer</name>

    <description>
        TorrentPlayer - video player for Samsung Smart TV
    </description>

    <!-- Точка входа -->
    <content src="src/index.html" />

    <!-- Иконка будет добавлена перед первой сборкой -->
    <icon src="assets/icon.png" />


    <!-- Tizen application -->
    <tizen:application
        id="TorrentPlayer.Tizen"
        package="TrntPlyr"
        required_version="8.0" />


    <!-- Интернет -->
    <tizen:privilege
        name="http://tizen.org/privilege/internet" />

    <!-- Управление TV input -->
    <tizen:privilege
        name="http://tizen.org/privilege/tv.inputdevice" />


    <!-- Разрешаем сетевые подключения -->
    <access
        origin="*"
        subdomains="true" />


    <!-- Приложение работает без мыши -->
    <tizen:setting
        pointing-device-support="disable" />

</widget>
```
